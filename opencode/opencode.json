{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "built-in-browser": "deny",
      "chrome-browser": "deny",
      "computer-use": "deny",
      "docs": "deny",
      "google-workspace": "deny",
      "import-memory": "deny",
      "morning": "deny"
    }
  }
}
